		{"id":"4aa4de33f5b7053e","type":"text","text":"### criado para testar uma ideia ou requisito e depois abandonado.","x":747,"y":1524,"width":455,"height":116},
		{"id":"6ffe8c6e1f020853","type":"text","text":"## DESCARTÁVEL","x":874,"y":1363,"width":200,"height":60},
		{"id":"f508bb63a21aa0fd","type":"text","text":"## EVOLUTIVO","x":1203,"y":1363,"width":178,"height":60},
